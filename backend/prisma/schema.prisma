// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DEALER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("")
  role      Role     @default(DEALER)
  createdAt DateTime @default(now())
  products  Product[]
}

model Category {
  id            String        @id @default(cuid())
  nameUz        String        @default("")
  nameRu        String        @default("")
  nameEn        String        @default("")
  name          String        @default("")
  slug          String        @unique
  image         String        @default("")
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  nameUz     String   @default("")
  nameRu     String   @default("")
  nameEn     String   @default("")
  name       String   @default("")
  slug       String   @unique
  image      String   @default("")
  order      Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Banner {
  id        String   @id @default(cuid())
  image     String   @default("")
  link      String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Product {
  id             String   @id @default(cuid())
  nameUz         String
  nameRu         String
  nameEn         String
  descriptionUz  String   @default("")
  descriptionRu  String   @default("")
  descriptionEn  String   @default("")
  brand          String[]
  type           String
  subtype        String   @default("")
  image          String   @default("")
  costPrice      Float    @default(0)
  sellPrice      Float    @default(0)
  wholesalePrice Float    @default(0)
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
