# ============================================
# Petronix Production Environment Variables
# ============================================
# Copy this file to .env and fill in your OWN values:
#   cp .env.example .env
#   nano .env
# NEVER commit the real .env. Do not put real secrets in this example file.

# ОБЯЗАТЕЛЬНО: IP адрес или домен вашего сервера (для сборки фронтенда)
SERVER_HOST=your-server-ip-or-domain

# Пароль базы данных — задайте надёжный
DB_PASSWORD=change-me-strong-db-password

# JWT секретный ключ — сгенерируйте уникальный:  openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Telegram бот для заявок/уведомлений (получите токен у @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
